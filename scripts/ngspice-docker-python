#!/usr/bin/env python3
"""
ngspice-docker-smart - Intelligent wrapper for ngspice in Docker
Automatically translates macOS paths to Docker paths
"""

import sys, os, subprocess, tempfile, re

PDK_ROOT = os.environ.get("PDK_ROOT")
if not PDK_ROOT:
    print("Error: PDK_ROOT not set", file=sys.stderr)
    sys.exit(1)

DOCKER_IMAGE = "hpretl/iic-osic-tools:latest"
DOCKER_PDK = "/pdk"

def translate_path(path):
    """Translate macOS path to Docker path"""
    path = path.strip('\'"')
    
    if path.startswith(DOCKER_PDK):
        return path
    
    cwd = os.getcwd()
    
    if PDK_ROOT and PDK_ROOT in path:
        return path.replace(PDK_ROOT, DOCKER_PDK)
    
    if path.startswith(cwd):
        return path.replace(cwd, '/work')
    
    return path

def process_netlist(netlist_path):
    with open(netlist_path) as f:
        content = f.read()
    
    for pattern, fmt in [
        (r'\.include\s+[\'"]?([^\s\'"]+)[\'"]?', '.include {}'),
        (r'\.lib\s+[\'"]?([^\s\'"]+)[\'"]?', '.lib {}'),
        (r'pre_osdi\s+[\'"]?([^\s\'"]+)[\'"]?', 'pre_osdi {}'),
        (r'osdi\s+[\'"]?([^\s\'"]+)[\'"]?', 'osdi {}'),
        (r'write\s+[\'"]?([^\s\'"]+)[\'"]?', 'write {}'),
    ]:
        content = re.sub(pattern, 
                        lambda m: fmt.format(translate_path(m.group(1))), 
                        content)
    
    fd, path = tempfile.mkstemp(suffix='.sp', text=True)
    with os.fdopen(fd, 'w') as f:
        f.write(content)
    return path

args = sys.argv[1:]
netlist = None
cwd = os.getcwd()

# Translate arguments
for i, arg in enumerate(args):
    # Translate -o output file path
    if arg == '-o' and i + 1 < len(args):
        output_path = args[i + 1]
        if output_path.startswith(cwd):
            args[i + 1] = output_path.replace(cwd, '/work')
    
    # Process netlist files
    elif arg.endswith(('.sp', '.cir', '.spice', '.txt')) and os.path.isfile(arg):
        netlist = process_netlist(arg)
        args[i] = os.path.basename(netlist)

cmd = ['docker', 'run', '--rm',
       '-v', f'{cwd}:/work',
       '-v', f'{PDK_ROOT}:{DOCKER_PDK}',
       '-w', '/work']

if netlist:
    cmd.extend(['-v', f'{netlist}:/work/{os.path.basename(netlist)}'])

cmd.extend([DOCKER_IMAGE, '--skip', 'ngspice'] + args)

try:
    result = subprocess.run(cmd, stdin=sys.stdin, stdout=sys.stdout, stderr=sys.stderr)
    if netlist:
        os.unlink(netlist)
    sys.exit(result.returncode)
except KeyboardInterrupt:
    sys.exit(130)
